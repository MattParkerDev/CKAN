@page "/"

@inject RepositoryDataManager RepositoryDataManager
@inject RegistryManager RegistryManager

@* @foreach(var module in _ckanModules) *@
@* { *@
@*     <MudText>@module.SearchableName</MudText> *@
@* } *@

<MudDataGrid Items="@_ckanModules">
    <Columns>
        <PropertyColumn Property="arg => arg.SearchableName" />
        <PropertyColumn Property="arg => arg.SearchableAuthors">
            <CellTemplate>
                @(string.Join(", ", context.Item.SearchableAuthors))
            </CellTemplate>
        </PropertyColumn>
    </Columns>
</MudDataGrid>

@code {

    private List<AvailableModule> _modules = [];
    private List<CkanModule> _ckanModules = [];
    protected override async Task OnInitializedAsync()
    {
        RepositoryDataManager.Prepopulate(RegistryManager.registry.Repositories.Values.ToList(), null);

        if (RegistryManager.registry.HasAnyAvailable() is false)
        {
            // Abort the refresh so we can update the repo data
        }

        var repository = RegistryManager.registry.Repositories.Single().Value;
        var modules = RepositoryDataManager.GetAllAvailableModules([repository]).ToList();
        _modules = modules;
        _ckanModules = modules
            .Select(m => m.Latest(ReleaseStatus.stable) ?? throw new InvalidOperationException())
            .OrderBy(m => m.SearchableName)
            .ToList();
        Console.WriteLine("Done");
    }

}

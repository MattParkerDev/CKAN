@page "/"
@using System.Diagnostics
@using ByteSizeLib

@inject RepositoryDataManager RepositoryDataManager
@inject RegistryManager RegistryManager

<style>
    .mod-list-table .mud-table-cell { font-size: 0.7rem; }
</style>
<MudDataGrid Class="" Elevation="2" Height="calc(100vh - 150px)" Dense="true" Items="@_ckanModules" Loading="@_loading" Virtualize="true" FixedHeader="true" ColumnResizeMode="@(_loading ? ResizeMode.Column : ResizeMode.Container)">
    <ColGroup>
        @* <col style="max-width: 10%; min-width: 100px"/> *@
        @* <col style="max-width: 10%; min-width: 100px"/> *@
        @* <col style="max-width: 0;  min-width: 0"/> *@
        @* <col style="max-width: 12%; min-width: 0"/> *@
        @* <col style="max-width: 5%;  min-width: 0"/> *@
        @* <col style="max-width: 5%;  min-width: 0"/> *@
        @* <col style="max-width: 13%; min-width: 0"/> *@
        @* <col style="max-width: 5%;  min-width: 0"/> *@
        @* <col/> *@
        <col/>
        <col/>
        <col/>
        <col/>
        <col/>
        <col/>
        <col/>
        <col/>
    </ColGroup>
    <Columns>
        @* <PropertyColumn Property="s => s.SearchableIdentifier" Title="Installed" CellStyle="@_cellStyle" /> *@
        <PropertyColumn Property="s => s.SearchableName" Title="Name" CellStyle="max-width: 310px; min-width: 50px; width: 310px; overflow-x: hidden; white-space: nowrap;"/>
        <PropertyColumn Property="s => s.SearchableAuthors" Title="Author" CellStyle="@_cellStyle" Sortable="false">
            <CellTemplate>
                @(string.Join(", ", context.Item.SearchableAuthors))
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="s => s.version" Title="Version" Sortable="false" CellStyle="@_cellStyle"/>
        <PropertyColumn Property="s => s.ksp_version" Title="KSP Version" CellStyle="@_cellStyle"/>
        <PropertyColumn Property="s => s.download_size" Title="Download" CellStyle="@_cellStyle">
            <CellTemplate>
                @ByteSize.FromBits(context.Item.download_size).ToString()
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="s => s.install_size" Title="Install" CellStyle="@_cellStyle">
            <CellTemplate>
                @ByteSize.FromBits(context.Item.install_size).ToString()
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="s => s.release_date" Title="Release Date" CellStyle="@_cellStyle"/>
        <PropertyColumn Property="s => s.ksp_version_max" Title="Downloads" CellStyle="@_cellStyle"/>
    </Columns>
</MudDataGrid>
<MudText>@_ckanModules.Count items</MudText>

@code {

    private List<AvailableModule> _modules = [];
    private List<CkanModule> _ckanModules = [];
    private bool _loading = false;
    
    private const string _cellStyle = "max-width: 400px; min-width: 50px; overflow-x: hidden; white-space: nowrap;";
    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        Console.WriteLine("Loading registry");
        var timer = Stopwatch.StartNew();
        await Task.Run(() => RepositoryDataManager.Prepopulate(RegistryManager.registry.Repositories.Values.ToList(), null));
        timer.Stop();
        Console.WriteLine($"Prepopulate took {timer.ElapsedMilliseconds}ms");

        var repository = RegistryManager.registry.Repositories.Single().Value;
        var modules = await Task.Run(() => RepositoryDataManager.GetAllAvailableModules([repository]).ToList());
        _modules = modules;
        var ckanModules = modules
            .Select(m => m.Latest(ReleaseStatus.stable) ?? throw new InvalidOperationException())
            .OrderBy(m => m.SearchableName)
            .ToList();
        _loading = false;
        _ckanModules = ckanModules;
        Console.WriteLine("Done");
    }

}
